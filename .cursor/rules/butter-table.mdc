### `packages/butter-ui/src/Table.tsx`
```tsx
import { forwardRef } from 'react';
import { useVirtualTable } from '@butter-table/butter-virtual';
import { TableRootProps } from './types';

export const TableRoot = forwardRef<HTMLTableElement, TableRootProps>(
  ({ instance, className, style, ...rest }, ref) => {
    const { rows, virtualizer } = useVirtualTable(instance);
    return (
      <table
        ref={ref}
        role="grid"
        aria-rowcount={instance.getTotalRowCount()}
        className={cn('bt-table', className)}
        style={style}
        {...rest}
      >
        {/* header + body rendered here */}
      </table>
    );
  },
);
```

